{
  "name": "campusfind",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "node server/index.js",
    "dev:all": "node server/dev.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server/index.js",
    "test": "vitest run",
    "test:core": "node --test tests/match.node.test.mjs",
    "test:backend": "node --test tests/backend.node.test.mjs",
    "test:all": "node --test tests/*.node.test.mjs",
    "admin:grant": "node server/admin.js grant",
    "admin:revoke": "node server/admin.js revoke"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
