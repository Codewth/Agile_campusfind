# Optional environment for the standalone CampusFind backend
PORT=3001
DATABASE_PATH=server/data/campusfind.sqlite
UPLOAD_DIR=server/data/uploads
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173,http://localhost:3001
# Firebase Web SDK configuration. These values are public; never put a private key here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Backend token verification project ID.
FIREBASE_PROJECT_ID=
# In production, run behind HTTPS and set NODE_ENV=production.
# Optional: only permit registration using this exact email domain.
# CAMPUS_EMAIL_DOMAIN=college.edu
